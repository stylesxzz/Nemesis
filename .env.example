# NVIDIA API key (keep private; never commit .env)
NVIDIA_API_KEY=
# Set this to a model currently available to your NVIDIA account.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_TOKENS=2000

# Optional n8n webhook URL. Leave blank to disable.
N8N_WEBHOOK_URL=

# Local backend settings
NEMESIS_HOST=127.0.0.1
NEMESIS_PORT=8765
